# Valeurs par défaut (dev). Surcharger dans .env.local ou via les variables Docker.
APP_ENV=dev
APP_SECRET=change_me_6f1c2b9e4a7d8f03b5e2c1a9d4f7e8b2

# PostgreSQL
DATABASE_URL="postgresql://app:app_password@database:5432/beignets?serverVersion=16&charset=utf8"

# JWT (clés générées au démarrage du conteneur)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=beignets_jwt_passphrase_change_me

# CORS (front Vite en dev)
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'

# Paramètres boutique
SHOP_WHATSAPP_NUMBER=33767339532
